---
import LogoIcon from "@/assets/logo.svg";
const nav = [
  { name: "Características", href: "#characters-section" },
  { name: "Precios", href: "#prices-section" },
];
---

<div
  class="fixed top-2 w-11/12 left-1/2 -translate-x-1/2 backdrop-blur-sm z-50 header rounded-full"
>
  <header class="flex items-center gap-2 justify-between p-2">
    <div class="logo ml-2">
      <a href="#" class="flex items-center gap-2 font-semibold text-lg">
        <LogoIcon class="h-8 w-auto" />
        <span class="text-shadow-lg text-shadow-green-100">Championship</span>
      </a>
    </div>
    <nav class="nav-header">
      <ul class="nav-links flex items-center gap-4">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="cta-header">
      <a href="#" class="btn btn-primary block">Registrarse</a>
    </div>
  </header>
</div>

<style>
  .header {
    animation: scrollDown 0.5s ease-in-out both;
    animation-timeline: scroll(root);
    animation-range: 0 200px;
  }
  @keyframes scrollDown {
    100% {
      background-color: #ffffff50;
      transform: scale(0.95) translateY(10px);
      box-shadow: 0 4px 10px -1px rgba(0, 0, 0, 0.2);
    }
  }
  .nav-header {
    display: none;
  }
  @media (min-width: 768px) {
    .nav-header {
      display: block;
    }
  }
</style>
