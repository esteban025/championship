---
import { Icon } from "astro-icon/components";
const stats = [
  { label: "Organizadores", value: "+500", icon: "mdi:account-group" },
  { label: "Torneos", value: "+100", icon: "mdi:trophy" },
  { label: "Partidos", value: "+1,000", icon: "mdi:clipboard-list" },
];
---

<section
  class="min-h-dvh flex items-center justify-center flex-col px-2 relative overflow-hidden hero-section gap-22"
>
  <!-- <HeroParticles client:load /> -->
  <article
    class="w-full max-w-4xl mx-auto p-4 flex flex-col gap-4 items-center"
  >
    <span
      class="hero-announcement w-max block p-1 px-3 rounded-full border border-primary bg-forest-green-200 text-sm text-neutral-700"
      >Control en todo momento</span
    >
    <div id="headline-principal" class="space-y-2">
      <h1
        class="title-hero font-bold text-neutral-900 text-center text-balance leading-[1.1] mb-6"
      >
        ¡Gestiona tus torneos como un profesional!
      </h1>
      <p class="text-center text-neutral-600 description-hero text-pretty">
        La plataforma definitiva para organizar y administrar tus competiciones.
        Estadísticas, calendarios y mucho más.
      </p>
    </div>
    <div id="hero-actions" class="flex justify-center gap-2 mt-10">
      <a href="#characters-section" class="btn btn-primary"
        >Ver características</a
      >
      <a href="#prices-section" class="btn btn-secondary">Ver precios</a>
    </div>
  </article>
  <article
    id="hero-stats"
    class="flex items-center justify-center gap-10 gap-y-4 w-full flex-wrap"
  >
    {
      stats.map((stat) => (
        <div class="stat-item flex items-center gap-1 text-neutral-500 text-sm">
          <Icon name={stat.icon} class="stat-icon" size="2em" />
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </article>
</section>

<style>
  .hero-section {
    background: linear-gradient(
      to bottom,
      var(--color-forest-green-100) 10%,
      transparent
    );
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  .description-hero {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
  }
</style>
