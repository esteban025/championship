---
import { HeroParticles } from "@/lib/HeroParticles";
import { Icon } from "astro-icon/components";
const stats = [
  { label: "Organizadores", value: "+500", icon: "mdi:account-group" },
  { label: "Torneos", value: "+100", icon: "mdi:trophy" },
  { label: "Partidos", value: "+1,000", icon: "mdi:clipboard-list" },
];
---

<section
  class="min-h-dvh flex items-center justify-center flex-col p-2 relative overflow-hidden hero-section"
>
  <HeroParticles client:load />
  <span
    class="hero-announcement block p-1 px-3 rounded-full border border-primary bg-forest-green-100 text-sm text-neutral-700"
    >Control en todo momento</span
  >
  <article class="w-full max-w-4xl mx-auto space-y-6 p-4">
    <div id="headline-principal" class="space-y-2">
      <h1
        class="title-hero font-semibold text-neutral-900 text-center text-balance leading-[1.1] mb-6"
      >
        ¡Gestiona tus torneos como un profesional!
      </h1>
      <p class="text-center text-neutral-600 description-hero text-pretty">
        La plataforma definitiva para organizar y administrar tus competiciones.
        Estadísticas, calendarios y mucho más.
      </p>
    </div>
    <div id="hero-actions" class="flex justify-center gap-2">
      <a href="#characters-section" class="btn btn-primary"
        >Ver características</a
      >
      <a href="#prices-section" class="btn btn-secondary">Ver precios</a>
    </div>
    <div
      id="hero-stats"
      class="flex items-center justify-center gap-10 gap-y-4 mt-10 w-full flex-wrap"
    >
      {
        stats.map((stat) => (
          <div class="stat-item flex items-center gap-1 text-neutral-500 text-sm">
            <Icon name={stat.icon} class="stat-icon" size="2em" />
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </article>
</section>

<style>
  .hero-section {
    background: linear-gradient(
      to bottom,
      var(--color-forest-green-100) 10%,
      transparent
    );
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  .description-hero {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
  }
</style>
