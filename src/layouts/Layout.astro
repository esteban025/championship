---
import "../styles/global.css";

interface Props {
	titlePage?: string;
	descriptionPage?: string;
}
const {
	titlePage = "Championship | Organiza tus campeonatos de forma sencilla",
	descriptionPage = "Organiza y gestiona tus campeonatos de manera fácil y eficiente con nuestra plataforma intuitiva.",
}: Props = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{titlePage}</title>
		<meta name="description" content={descriptionPage} />
	</head>
	<body class="bg-neutral-100 text-neutral-800">
		<slot />
	</body>
</html>
