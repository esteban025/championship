---
import { Icon } from "astro-icon/components";
interface Props {
  title: string;
  description: string;
  icon: string;
}
const { title, description, icon } = Astro.props;
---

<div class="relative group w-full cursor-pointer perspective-1000">
  {/* Card principal con transformación 3D */}
  <div
    class="relative bg-white rounded-2xl p-8 border-2 border-gray-200 group-hover:border-forest-green-600/50 shadow-xl group-hover:shadow-[0_0_40px_rgba(0,151,0,0.3)] transition-all duration-700 group-hover:-translate-y-2 overflow-hidden h-full"
  >
    {/* Efecto de escaneo */}
    <div
      class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-1000"
    >
      <div
        class="absolute inset-0 bg-linear-to-b from-transparent via-forest-green-50 to-transparent h-full w-full animate-scan"
      >
      </div>
    </div>

    {/* Brillo superior holográfico */}
    <div
      class="absolute top-0 left-0 right-0 h-40 bg-linear-to-b from-forest-green-50 via-forest-green-100 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-t-3xl"
    >
    </div>

    {/* Icono con efectos extremos */}
    <div class="mb-7 relative inline-block">
      {/* Anillo orbital */}
      <div
        class="absolute -inset-3 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
      >
        <div
          class="absolute inset-0 rounded-full border-2 border-forest-green-700/50 animate-ping-slow"
        >
        </div>
      </div>
      {/* Contenedor del icono con efecto holográfico */}
      <div
        class="relative size-16 bg-linear-to-br from-forest-green-700 via-forest-green-500 to-forest-green-700 rounded-xl flex items-center justify-center shadow-2xl shadow-primary/60 group-hover:shadow-primary group-hover:scale-125 group-hover:rotate-12 transition-all duration-700 overflow-hidden"
      >
        {/* Reflejo holográfico animado */}
        <div
          class="absolute inset-0 bg-linear-to-br from-white/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
        <div
          class="absolute inset-0 bg-linear-to-tr from-transparent via-white/20 to-transparent animate-shimmer-fast"
        >
        </div>

        {/* SVG del trofeo mejorado */}
        <Icon
          name={icon}
          class="size-9 text-neutral-50 relative z-10 drop-shadow-2xl filter"
        />

        {/* Puntos de luz */}
        <div
          class="absolute top-1 right-1 size-2 bg-white rounded-full opacity-70 group-hover:opacity-100 animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-1 left-1 size-1.5 bg-white/60 rounded-full opacity-70 group-hover:opacity-100 animate-pulse-delayed"
        >
        </div>
      </div>
    </div>

    {/* Título con efecto neón */}
    <h3 class="text-2xl font-semibold mb-6 relative">
      <span
        class="bg-linear-to-r from-gray-900 via-gray-800 to-gray-900 bg-clip-text text-transparent group-hover:from-forest-green-950 group-hover:via-emerald-900 group-hover:to-forest-green-950 transition-all duration-700 drop-shadow-sm group-hover:drop-shadow-[0_0_20px_rgba(0,151,0,0.5)]"
      >
        {title}
      </span>
      {/* Subrayado animado */}
      <div
        class="absolute -bottom-2 left-0 h-0.5 w-0 group-hover:w-full bg-linear-to-r from-primary via-emerald-400 to-primary transition-all duration-700 rounded-full shadow-[0_0_10px_rgba(0,151,0,0.8)]"
      >
      </div>
    </h3>

    {/* Descripción con efecto de aparición */}
    <p
      class="text-gray-600 leading-relaxed group-hover:text-gray-700 transition-all duration-500 relative z-10"
    >
      {description}
    </p>

    {/* Esquinas decorativas */}
    <div
      class="absolute top-2 right-2 w-8 h-8 border-t-2 border-r-2 border-primary/20 rounded-tr-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    >
    </div>
    <div
      class="absolute bottom-2 left-2 w-8 h-8 border-b-2 border-l-2 border-primary/20 rounded-bl-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    >
    </div>
  </div>
</div>
<style>
  @keyframes shimmer-fast {
    0% {
      transform: translateX(-100%) translateY(-100%);
    }
    100% {
      transform: translateX(100%) translateY(100%);
    }
  }

  @keyframes scan {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @keyframes ping-slow {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  @keyframes pulse-delayed {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  .animate-shimmer-fast {
    animation: shimmer-fast 2s linear infinite;
  }

  .animate-scan {
    animation: scan 3s linear infinite;
  }

  .animate-ping-slow {
    animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .animate-pulse-delayed {
    animation: pulse-delayed 2s ease-in-out infinite;
    animation-delay: 1s;
  }

  .perspective-1000 {
    perspective: 1000px;
  }
</style>
